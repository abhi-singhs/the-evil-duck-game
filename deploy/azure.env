# Azure resources for the deployed game. Override any value in your shell before
# running deploy.sh, for example: LOCATION=eastus ./deploy/deploy.sh
#
# Subscription is deliberately absent. The script uses whatever `az account show`
# reports, so this file stays valid for anyone with their own subscription.

RESOURCE_GROUP=rg-abhising-tad-demo
LOCATION=westus2
REGISTRY=acrevilduck109048529
ENVIRONMENT=cae-evil-duck
APP=ca-evil-duck
IMAGE=evil-duck
PORT=8080

# One replica, always. A room is a single authoritative process, so a second
# replica would mean a second duck once the multiplayer server lands.
MIN_REPLICAS=1
MAX_REPLICAS=1
CPU=0.5
MEMORY=1Gi
